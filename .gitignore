# ==========================================
# PestShield - Root Git Ignore
# ==========================================

# Node.js dependencies
node_modules/

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build / generated files
dist/
build/
.next/
out/

# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/

# Temporary files
*.tmp
*.temp

# ==========================================
# Large dataset image files
# ==========================================

datasets/**/*.jpg
datasets/**/*.jpeg
datasets/**/*.png
datasets/**/*.JPG
datasets/**/*.JPEG
datasets/**/*.PNG

# ==========================================
# Large ML model files
# ==========================================

*.keras
*.h5
*.hdf5
*.pth
*.pt
*.pkl
*.joblib